# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# personlige nøgle-backups (ligger uden for repoet, men ignoreres hvis de flyttes ind)
API.txt

# vercel
.vercel

# supabase cli
supabase/.temp/

# golden-set (router-eval data, ikke kode)
golden-set-labeling.csv
golden-set-raw.json

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code lokale settings (tilladelses-regler mm., kun din maskine)
.claude/settings.local.json
