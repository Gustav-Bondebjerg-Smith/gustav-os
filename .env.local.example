# Gustav OS - miljøvariabler (skabelon)
# Kopiér denne fil til .env.local og udfyld værdierne efterhånden som du opretter dem.
# .env.local er gitignored og bliver ALDRIG committet.

# --- AI (bruges fra Fase 2) ---
# Anthropic API-key (hjernen). https://console.anthropic.com -> Settings -> API Keys
ANTHROPIC_API_KEY=
# OpenAI API-key (Whisper-transskription + embeddings). https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Supabase (bruges fra Fase 1) ---
# Fra Supabase dashboard -> Project Settings -> Data API / API Keys
# URL og anon key er sikre at eksponere i browseren (beskyttet af RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: KUN server-side. Aldrig i klient-kode. Holdes hemmelig.
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth (bruges fra Fase 7) ---
# Din egen email. Kun denne adresse må logge ind på dashboardet via magic link.
# Andre der prøver bliver afvist før Supabase overhovedet sender en email.
ALLOWED_EMAIL=
# Selvvalgt hemmelig streng til Vercel Cron endpoints (/api/cron/*).
CRON_SECRET=

# --- Telegram (bruges fra Fase 2) ---
# Bot-token fra @BotFather
TELEGRAM_BOT_TOKEN=
# Din egen Telegram chat-id (sikrer at kun du kan bruge botten). Finder vi sammen.
TELEGRAM_CHAT_ID=
# Selvvalgt hemmelig streng der verificerer at webhook-kald kommer fra Telegram
TELEGRAM_WEBHOOK_SECRET=

# --- Google Calendar (bruges fra Fase 3-4, ikke nu) ---
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# GOOGLE_CALENDAR_ID=
